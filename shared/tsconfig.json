{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    /*
     * CommonJS 출력을 고르는 이유:
     *  - server-match는 NestJS라 CJS다. ESM 전용 패키지를 require 할 수 없다.
     *  - Vite(client)와 최신 Node(server-game)는 CJS 의존성을 문제없이 읽는다.
     * 즉 CJS 하나가 세 소비자를 모두 만족시키는 유일한 단일 출력이다.
     */
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es2022",
    "lib": ["ES2022"],
    "types": [],

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  // 테스트는 tsconfig.test.json이 따로 컴파일한다. 런타임 코드가 Node 전역을 참조하면
  // 브라우저에서 깨지므로, 본 빌드에는 @types/node를 아예 넣지 않는다.
  "exclude": ["src/**/*.test.ts"]
}
