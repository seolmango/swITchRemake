{
  "name": "switch",
  "version": "1.0.0",
  "scripts": {
    "setup": "node scripts/env/cli.cjs setup",
    "env:check": "node scripts/env/cli.cjs check",
    "env:docs": "node scripts/env/cli.cjs docs",
    "balance": "node scripts/balance/cli.cjs status",
    "balance:release": "node scripts/balance/cli.cjs release",
    "dev": "node scripts/dev.cjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f",
    "db:restart": "docker compose restart",
    "db:redis-fix": "docker compose run --rm redis redis-check-aof --fix /data/appendonly.aof",
    "db:migrate": "npm run db:migrate -w server-match",
    "match:dev": "npm run dev -w server-match",
    "shared:build": "npm run build -w shared",
    "shared:watch": "npm run watch -w shared",
    "shared:test": "npm test -w shared",
    "game:build": "npm run build -w server-game",
    "game:dev": "npm run dev -w server-game",
    "game:start": "node scripts/start-game.cjs",
    "gateway:build": "npm run build -w server-gateway",
    "supervisor:build": "npm run build -w server-supervisor",
    "cluster:start": "node scripts/start-cluster.cjs",
    "test": "node scripts/run-workspaces.cjs test shared server-game server-gateway server-supervisor server-match client && node --test scripts/env/env.test.cjs scripts/verify/environment.test.cjs scripts/verify/replay-keys.test.cjs scripts/verify/bots.test.cjs",
    "typecheck": "node scripts/run-workspaces.cjs typecheck shared server-game server-gateway server-supervisor server-match client",
    "lint": "npm run lint -w client",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "node scripts/verify/cli.cjs",
    "verify:extended": "node scripts/verify/cli.cjs --extended",
    "build": "node scripts/run-workspaces.cjs build shared server-game server-gateway server-supervisor server-match client",
    "admin:grant": "node scripts/grant-admin.cjs",
    "replay:keygen": "node scripts/replay-keygen.cjs",
    "audio:build": "node scripts/build-audio.cjs",
    "icons:build": "node scripts/build-icons.cjs",
    "map:editor": "node tools/MapBuilder/editor/server.cjs",
    "stack:up": "node scripts/deploy-stack.cjs up",
    "stack:down": "node scripts/deploy-stack.cjs down",
    "stack:logs": "node scripts/deploy-stack.cjs logs",
    "stack:ps": "node scripts/deploy-stack.cjs ps"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "swITch — 실시간 멀티플레이 술래잡기 게임 (npm workspaces 루트)",
  "workspaces": [
    "shared",
    "client",
    "server-game",
    "server-gateway",
    "server-supervisor",
    "server-match"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "dotenv": "^17.4.1",
    "ioredis": "^5.11.1"
  },
  "overrides": {
    "fastify": "5.12.5"
  },
  "packageManager": "npm@11.21.0"
}
