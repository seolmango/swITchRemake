    "test": "tsc -p tsconfig.test.json && node ../scripts/run-tests.cjs dist-test"
  },
  "dependencies": {
    "ioredis": "^5.10.1",
    "shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
