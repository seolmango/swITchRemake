{
  "name": "server-gateway",
  "version": "1.0.0",
  "description": "swITch 게이트웨이. 사용자에게 주소 하나만 보이게 하고, 경로를 보고 인게임 서버로 넘긴다.",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
