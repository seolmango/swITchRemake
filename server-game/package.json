{
  "name": "server-game",
  "version": "1.0.0",
  "description": "swITch 인게임 서버. 방 소유, 고정 timestep 시뮬레이션, WebSocket 전송.",
  "type": "commonjs",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node scripts/run-tests.cjs",
    "replay:inspect": "node dist/replay/cli.js"
  },
  "dependencies": {
    "ioredis": "^5.10.1",
    "shared": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.12",
    "typescript": "^5.6.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
