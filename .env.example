# 루트 .env 템플릿. 실제 값은 .env에 넣는다(.env는 gitignore 대상).
# docker compose와 server-match가 같은 파일을 읽는다.

# --- PostgreSQL ---
DB_USER=switch
DB_PASSWORD=change-me
DB_NAME=switch
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
# REDIS_PASSWORD는 필수다. 비워두면 docker compose가 뜨지 않는다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- SMTP (인증 코드 메일) ---
# 로컬 기본값은 sink입니다. 실제 발송이 필요하면 smtp로 바꿉니다.
EMAIL_TRANSPORT=sink
SMTP_USER=
SMTP_PASSWORD=

# --- JWT ---
# 두 secret은 서로 다른 임의 값이어야 한다. 예: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_GUEST_REFRESH_SECRET=change-me-too
# 초 단위
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=1209600
JWT_GUEST_EXPIRATION=900
JWT_GUEST_REFRESH_EXPIRATION=3600

# --- Session IP protection ---
# HMAC 키는 32바이트 이상의 별도 임의 문자열이어야 한다.
SESSION_IP_HMAC_SECRET=change-me
# AES-256-GCM 키. `openssl rand -base64 32`로 만든 base64 값이어야 한다.
SESSION_IP_ENCRYPTION_KEY=change-me
# 암호화한 원본 IP 보관 기간(일). 이후 ip_encrypted만 null로 지운다.
SESSION_IP_RETENTION_DAYS=7

# --- 인게임 서버 (server-game) ---
# GAME_SERVER_ID는 필수. 프로세스마다 고유해야 한다.
GAME_SERVER_ID=game-local-p1
# Emergency only: permits starting despite a live heartbeat for this server ID.
GAME_ALLOW_DUPLICATE_SERVER_ID=false
GAME_PORT=4000
GAME_HOST=0.0.0.0
# 비어 있으면 WebSocket upgrade를 전부 거절한다. 콤마로 구분.
# Required: server-game refuses startup when this is empty.
GAME_ALLOWED_ORIGINS=http://localhost:5173
# 이 주소에서 온 요청에 한해 프록시가 넣은 client IP 헤더를 신뢰한다. 비어 있으면 소켓 주소를 쓴다.
GAME_TRUSTED_PROXIES=
# Redis 키 환경 prefix (dev/staging/prod)
APP_ENV=dev
# 배포 파이프라인이 주입. 경기 결과와 리플레이에 기록된다.
BUILD_ID=dev
# `s3`는 아직 구현이 없다. 로컬 개발은 켜 두고 REPLAY_LOCAL_DIR 아래에서 확인한다.
REPLAY_ENABLED=true
REPLAY_STORE=local
REPLAY_LOCAL_DIR=./replays
# Keep this distinct from the client SPA route /game.
GAME_PUBLIC_WS_PATH=/game-ws/local
# game:start supplies local defaults for GAME_SERVER_ID and GAME_MAP_BUNDLE. When
# running the built server directly, GAME_MAP_BUNDLE must be an absolute path.
# GAME_MAP_BUNDLE=C:/absolute/path/to/server_maps.json
