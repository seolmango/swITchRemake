# 루트 .env 템플릿. 실제 값은 .env에 넣는다(.env는 gitignore 대상).
# docker compose와 server-match가 같은 파일을 읽는다.

# --- PostgreSQL ---
DB_USER=switch
DB_PASSWORD=change-me
DB_NAME=switch
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
# REDIS_PASSWORD는 필수다. 비워두면 docker compose가 뜨지 않는다.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# --- SMTP (인증 코드 메일) ---
# 로컬 기본값은 sink입니다. 실제 발송이 필요하면 smtp로 바꿉니다.
EMAIL_TRANSPORT=sink

# --- 자동 점검 ---
# 브라우저 자동 점검(npm run e2e)은 한 IP에서 수십 개 계정을 만들고 지웁니다. 인증 메일
# 요청이 IP당 분당 5회라 그대로는 끝까지 못 돕니다. true면 한도만 50배로 넓히고
# 가드는 그대로 돕니다. APP_ENV=prod면 서버가 부팅을 거부합니다.
RATE_LIMIT_RELAXED=false
SMTP_USER=
SMTP_PASSWORD=

# --- 매칭 서버가 신뢰할 프록시 ---
# 여기 적힌 주소에서 온 요청에 한해 X-Forwarded-For를 믿는다. 콤마로 구분하고 CIDR도 된다.
# 비어 있으면 소켓 주소를 쓴다. 리버스 프록시 뒤에서 비워 두면 모든 요청이 프록시 한 IP로
# 보이므로 IP 기반 제한이 전역이 된다. 반대로 아무나 믿으면 헤더 한 줄로 그 제한이 사라진다.
MATCH_TRUSTED_PROXIES=

# --- JWT ---
# 셋 다 서로 다른 임의 값이어야 하고 32자 이상이어야 한다. 예: openssl rand -base64 48
# 하나라도 빠지거나 겹치면 매칭 서버가 부팅하지 않는다(main.ts의 assertDistinctJwtSecrets).
JWT_ACCESS_SECRET=change-me-1-with-at-least-32-characters
JWT_REFRESH_SECRET=change-me-2-with-at-least-32-characters
JWT_GUEST_REFRESH_SECRET=change-me-3-with-at-least-32-characters
# 초 단위
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=1209600
JWT_GUEST_EXPIRATION=900
JWT_GUEST_REFRESH_EXPIRATION=3600

# --- Session IP protection ---
# HMAC 키는 32바이트 이상의 별도 임의 문자열이어야 한다.
SESSION_IP_HMAC_SECRET=change-me
# AES-256-GCM 키. `openssl rand -base64 32`로 만든 base64 값이어야 한다.
SESSION_IP_ENCRYPTION_KEY=change-me
# 암호화한 원본 IP 보관 기간(일). 이후 ip_encrypted만 null로 지운다.
SESSION_IP_RETENTION_DAYS=7

# --- 인게임 서버 (server-game) ---
# GAME_SERVER_ID는 필수. 프로세스마다 고유해야 한다.
GAME_SERVER_ID=game-local-p1
# Emergency only: permits starting despite a live heartbeat for this server ID.
GAME_ALLOW_DUPLICATE_SERVER_ID=false
GAME_PORT=4000
# 이 프로세스가 동시에 들고 있을 방의 상한. 넘으면 SERVER_FULL로 거절하고 매칭 서버가
# 다른 서버를 고른다. 측정으로 나온 값이 아니라 보수적인 출발점이다.
GAME_MAX_ROOMS=100
GAME_HOST=0.0.0.0
# 비어 있으면 WebSocket upgrade를 전부 거절한다. 콤마로 구분.
# Required: server-game refuses startup when this is empty.
GAME_ALLOWED_ORIGINS=http://localhost:5173
# 이 주소에서 온 요청에 한해 프록시가 넣은 client IP 헤더를 신뢰한다. 비어 있으면 소켓 주소를 쓴다.
GAME_TRUSTED_PROXIES=
# Redis 키 환경 prefix (dev/staging/prod)
APP_ENV=dev
# 배포 파이프라인이 주입. 경기 결과와 리플레이에 기록된다.
BUILD_ID=dev
# `s3`는 아직 구현이 없다. 로컬 개발은 켜 두고 REPLAY_LOCAL_DIR 아래에서 확인한다.
REPLAY_ENABLED=true
REPLAY_STORE=local
REPLAY_LOCAL_DIR=./replays
# Keep this distinct from the client SPA route /game.
GAME_PUBLIC_WS_PATH=/game-ws/local
# game:start supplies local defaults for GAME_SERVER_ID and GAME_MAP_BUNDLE. When
# running the built server directly, GAME_MAP_BUNDLE must be an absolute path.
# GAME_MAP_BUNDLE=C:/absolute/path/to/server_maps.json

# --- 보관 기간 ---
# 경기 전적(경기·참가자 행)을 남길 기간(일).
MATCH_RETENTION_DAYS=30
# 리플레이를 남길 기간(일). 아래 개수 조건과 함께, 둘 중 먼저 걸리는 쪽이 이긴다.
REPLAY_RETENTION_DAYS=7
# 사람별 기준이다. 파일 하나를 최대 8명이 나눠 갖기 때문에, 참가자 중 한 명이라도 자기 최근
# 이 개수 안에 그 경기를 들고 있으면 남긴다. 아무도 안 들고 있을 때만 지운다.
REPLAY_RETENTION_MAX_MATCHES=50
# 정리 회차 간격(분). 첫 회차는 부팅 1분 뒤다 — 여러 대가 동시에 뜨는 순간이 제일 시끄럽다.
RETENTION_INTERVAL_MINUTES=10

# --- 리플레이 서명 ---
# `npm run replay:keygen [keyId]` 로 한 쌍을 만들어 아래 셋을 채운다.
# 비워 두면 서명하지 않는다 — 개발 중에는 그게 정상이고, 재생기는 그런 파일을
# "확인할 수 없음"으로 표시한다. 조작됐다는 뜻이 아니다.
#
# 개인키는 인게임 서버만 든다. PKCS#8 PEM을 base64로 한 줄에 담는다.
REPLAY_SIGNING_KEY=
REPLAY_SIGNING_KEY_ID=
# 공개키는 매칭 서버가 화면에 내려 준다. `keyId:base64` 를 쉼표로 이어 여러 개를 둘 수 있고,
# 그래야 키를 바꾸는 동안 옛 파일도 계속 검증된다.
REPLAY_SIGNING_PUBLIC_KEYS=
