switch-dev-193234.koreacentral.cloudapp.azure.com {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Restrict embedding and active object/base injection without relaxing
        # script execution policy or breaking the current Phaser asset loader.
        Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
    }

    @api path /api/*
    handle @api {
        uri strip_prefix /api
        reverse_proxy match:3000
    }

    @game path /game-ws* /map-bundles/* /replays/*
    handle @game {
        reverse_proxy cluster:4100
    }

    handle {
        reverse_proxy web:80
    }
}
