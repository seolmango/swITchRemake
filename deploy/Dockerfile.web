FROM node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6 AS build
WORKDIR /app

# Keep the complete workspace manifest graph available to npm's lockfile resolver.
COPY package.json package-lock.json ./
# shared's prepare lifecycle compiles its TypeScript during npm ci.
COPY shared ./shared
COPY client/package.json ./client/package.json
COPY server-game/package.json ./server-game/package.json
COPY server-gateway/package.json ./server-gateway/package.json
COPY server-supervisor/package.json ./server-supervisor/package.json
COPY server-match/package.json ./server-match/package.json
RUN npm install --global npm@11.21.0 && npm ci --no-audit --no-fund

COPY . .
RUN npm run build -w shared && npm run build -w client

FROM nginx:1.28-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/client/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
