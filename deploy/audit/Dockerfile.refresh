ARG AUDIT_RUNNER_IMAGE
FROM ${AUDIT_RUNNER_IMAGE}
# Local iteration only: preserve installed browsers, update audit code and tests.
COPY scripts ./scripts
COPY e2e ./e2e
COPY client ./client
COPY legal ./legal
COPY server-match ./server-match
COPY shared ./shared
COPY server-game ./server-game
COPY server-gateway ./server-gateway
COPY server-supervisor ./server-supervisor
COPY .github/workflows/audit.yml ./.github/workflows/audit.yml
COPY deploy/audit/compose.yml deploy/audit/Dockerfile.backend ./deploy/audit/
COPY deploy/nginx.conf ./deploy/nginx.conf
COPY deploy/azure/Caddyfile ./deploy/azure/Caddyfile
COPY Dockerfile.backend ./Dockerfile.backend
