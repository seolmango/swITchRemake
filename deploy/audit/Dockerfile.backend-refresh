ARG AUDIT_BACKEND_IMAGE
FROM ${AUDIT_BACKEND_IMAGE}
# Local code iteration only. Clean CI uses Dockerfile.backend and npm ci.
USER root
COPY shared ./shared
COPY server-match ./server-match
COPY server-game ./server-game
COPY server-gateway ./server-gateway
COPY server-supervisor ./server-supervisor
COPY scripts ./scripts
RUN node scripts/run-workspaces.cjs build shared server-match server-game server-gateway server-supervisor
COPY scripts/audit-cluster.cjs /app/docker-cluster.cjs
USER node
